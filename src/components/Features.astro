---
import { features } from '../data/site';

// Простые линейные иконки (SVG), рисуются цветом текста
const icons: Record<string, string> = {
  shield:
    '<path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.4 7.5 9.5 4.3-1.1 7.5-4.9 7.5-9.5V6L12 3Z"/><path d="m8.8 12.2 2.2 2.2 4.3-4.6"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  drop: '<path d="M12 3.5s6 6.4 6 10.6a6 6 0 0 1-12 0C6 9.9 12 3.5 12 3.5Z"/><path d="M9.5 14.5a2.5 2.5 0 0 0 2.5 2.5"/>',
  cup: '<path d="M5 9h11v5a5 5 0 0 1-5 5h-1a5 5 0 0 1-5-5V9Z"/><path d="M16 10.5h1.5a2.5 2.5 0 0 1 0 5H16"/><path d="M9 3.5c0 1.2 1 1.3 1 2.5M12.5 3.5c0 1.2 1 1.3 1 2.5"/>',
};
---

<section class="section features" aria-labelledby="features-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">Почему «Пудра»</p>
      <h2 id="features-title">Красиво снаружи, <em>честно</em> внутри</h2>
    </div>

    <ul class="bento">
      {
        features.map((f, i) => (
          <li class={`tile tile--${i + 1}`} data-reveal style={`--d: ${i}`}>
            <span class="tile__icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="28"
                height="28"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={icons[f.icon]}
              />
            </span>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .bento {
    display: grid;
    gap: 1rem;
    padding: 0;
    list-style: none;
  }

  .tile {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    min-height: 15rem;
    padding: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
    border-radius: var(--r-md);
    background: var(--c-surface);
  }

  .tile p {
    max-width: 26rem;
    color: var(--c-muted);
  }

  .tile__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-bottom: auto;
    border-radius: 50%;
    background: var(--c-bg);
    color: var(--c-accent);
  }

  .tile h3 {
    margin-top: 2rem;
  }

  /* Акцентная плитка */
  .tile--1 {
    background: var(--c-accent);
    color: var(--c-on-accent);
  }

  .tile--1 p {
    color: rgb(255 248 245 / 0.82);
  }

  .tile--1 .tile__icon {
    background: rgb(255 248 245 / 0.12);
    color: var(--c-on-accent);
  }

  .tile--4 {
    background: var(--c-blush);
  }

  .tile--4 p {
    color: var(--c-text);
  }

  @media (min-width: 640px) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .bento {
      grid-template-columns: repeat(6, 1fr);
    }

    .tile--1,
    .tile--4 {
      grid-column: span 4;
    }

    .tile--2,
    .tile--3 {
      grid-column: span 2;
    }

    .tile {
      min-height: 17rem;
    }
  }
</style>
