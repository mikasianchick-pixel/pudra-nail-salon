---
import { reviews, site } from '../data/site';
---

<section id="reviews" class="section" aria-labelledby="reviews-title">
  <div class="container">
    <div class="reviews__head" data-reveal>
      <div class="section-head">
        <p class="eyebrow">Отзывы</p>
        <h2 id="reviews-title">Нам <em>доверяют</em> руки</h2>
      </div>
      <div class="score">
        <p class="score__num">{site.rating}</p>
        <div>
          <p class="score__stars" aria-hidden="true">★★★★★</p>
          <p class="score__text">{site.reviewsCount} отзывов на Яндекс Картах</p>
          <a class="link-arrow" href={site.mapUrl} target="_blank" rel="noopener noreferrer">
            Читать все <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="reviews__scroller" data-reveal tabindex="0" role="region" aria-label="Отзывы клиентов, листайте вбок">
    <ul class="reviews">
      {
        reviews.map((r) => (
          <li class="review">
            <p class="review__stars" aria-label="Оценка 5 из 5">
              ★★★★★
            </p>
            <blockquote class="review__text">
              <p>{r.text}</p>
            </blockquote>
            <p class="review__author">
              <strong>{r.name}</strong>
              <span>{r.date}</span>
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .reviews__head {
    display: grid;
    gap: 0 2rem;
    align-items: end;
  }

  .score {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .score__num {
    font-family: var(--f-serif);
    font-size: clamp(4rem, 3rem + 4vw, 6rem);
    line-height: 0.9;
    color: var(--c-accent);
  }

  .score__stars,
  .review__stars {
    letter-spacing: 0.1em;
    color: var(--c-gold);
  }

  .score__text {
    font-size: var(--fs-small);
    color: var(--c-muted);
  }

  .reviews__scroller {
    /* Отступы совпадают с контейнером, а прокрутка — на всю ширину экрана */
    --pad: max(var(--gutter), calc((100vw - var(--container)) / 2));
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--pad);
    scrollbar-width: none;
  }

  .reviews__scroller::-webkit-scrollbar {
    display: none;
  }

  .reviews {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(85vw, 22rem);
    gap: 1rem;
    width: max-content;
    padding: 0 var(--pad) 0.5rem;
    list-style: none;
  }

  .review {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem;
    border-radius: var(--r-md);
    background: var(--c-surface);
    scroll-snap-align: start;
  }

  .review__text {
    flex: 1;
    font-family: var(--f-serif);
    font-size: 1.25rem;
    line-height: 1.45;
  }

  .review__author {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: var(--fs-small);
  }

  .review__author span {
    color: var(--c-muted);
  }

  @media (min-width: 1024px) {
    .reviews__head {
      grid-template-columns: 1fr auto;
    }

    .reviews__scroller {
      overflow: visible;
    }

    .reviews {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, 1fr);
      grid-auto-columns: auto;
      width: auto;
      max-width: calc(var(--container) + var(--gutter) * 2);
      margin-inline: auto;
      padding: 0 var(--gutter);
      gap: 1.25rem;
    }
  }
</style>
