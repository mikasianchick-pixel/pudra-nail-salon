---
/**
 * Основной шаблон страницы: <head>, SEO, шрифты, общие стили.
 */
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
// Главные файлы шрифтов (кириллица) — грузим заранее, чтобы заголовок не «прыгал» при загрузке
import fontSansCyr from '@fontsource-variable/manrope/files/manrope-cyrillic-wght-normal.woff2?url';
import fontSerifCyr from '@fontsource/cormorant-garamond/files/cormorant-garamond-cyrillic-500-normal.woff2?url';

import { getImage } from 'astro:assets';
import { site } from '../data/site';
import { url } from '../utils/url';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} — студия маникюра в Москве на Пречистенке`,
  description = site.description,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: site.heroImage, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site);

// Микроразметка для поисковиков: Яндекс и Google понимают, что это салон, где он и когда работает.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NailSalon',
  name: `${site.name} — ${site.tagline}`,
  description: site.description,
  url: new URL(url(), Astro.site).toString(),
  image: ogUrl.toString(),
  telephone: site.phoneHref.replace('tel:', ''),
  priceRange: '1600–6800 ₽',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address,
    addressLocality: site.city,
    addressCountry: 'RU',
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '10:00',
    closes: '22:00',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: site.rating.replace(',', '.'),
    reviewCount: site.reviewsCount,
  },
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preload" href={fontSerifCyr} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontSansCyr} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#fbf7f3" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Метка «JS работает»: только тогда прячем блоки для анимации появления -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />

    <script>
      // Плавное появление блоков при прокрутке
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0 },
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
