---
import { Picture } from 'astro:assets';
import { masters } from '../data/site';
---

<section id="masters" class="section section--surface" aria-labelledby="masters-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">Команда</p>
      <h2 id="masters-title">Мастера, к которым <em>возвращаются</em></h2>
      <p>Каждый мастер проходит обучение и аттестацию у нас. Средний стаж команды&nbsp;— 6&nbsp;лет.</p>
    </div>

    <ul class="masters">
      {
        masters.map((m, i) => (
          <li class="master" data-reveal style={`--d: ${i}`}>
            <div class="master__photo">
              <Picture
                src={m.photo}
                alt={`${m.name}, ${m.role.toLowerCase()}`}
                formats={['avif', 'webp']}
                widths={[360, 540, 720]}
                sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw"
                class="master__img"
              />
            </div>
            <div class="master__body">
              <p class="eyebrow">
                {m.role} · стаж {m.experience}
              </p>
              <h3>{m.name}</h3>
              <p class="master__skills">{m.skills}</p>
              <a class="link-arrow" href="#booking" data-book-master={m.id}>
                Записаться к мастеру <span aria-hidden="true">→</span>
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .masters {
    display: grid;
    gap: 2.5rem 1.5rem;
    padding: 0;
    list-style: none;
  }

  .master {
    display: grid;
    gap: 1.25rem;
  }

  .master__photo {
    overflow: hidden;
    border-radius: var(--r-md);
    background: var(--c-blush);
  }

  .master__photo :global(picture) {
    display: block;
  }

  .master__photo :global(.master__img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 20%;
    /* Все портреты в ч/б — единый журнальный стиль */
    filter: grayscale(1) contrast(1.05);
    transition:
      filter 0.6s var(--ease),
      transform 0.8s var(--ease);
  }

  .master:hover .master__photo :global(.master__img),
  .master:focus-within .master__photo :global(.master__img) {
    filter: grayscale(0);
    transform: scale(1.03);
  }

  .master__body {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }

  .master__skills {
    color: var(--c-muted);
  }

  @media (min-width: 640px) {
    .masters {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .masters {
      grid-template-columns: repeat(3, 1fr);
    }

    /* Средняя карточка чуть ниже — «журнальный» ритм */
    .master:nth-child(2) {
      margin-top: 4rem;
    }
  }
</style>
