---
import { Picture } from 'astro:assets';
import { site, hygieneSteps, brands } from '../data/site';
---

<section class="section section--surface" aria-labelledby="hygiene-title">
  <div class="container hygiene">
    <div class="hygiene__media" data-reveal>
      <Picture
        src={site.hygieneImage}
        alt="Мастер в перчатках работает стерильными инструментами"
        formats={['avif', 'webp']}
        widths={[400, 640, 900]}
        sizes="(min-width: 1024px) 45vw, 92vw"
        class="hygiene__img"
      />
    </div>

    <div class="hygiene__content">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Стерильность</p>
        <h2 id="hygiene-title">Безопасность&nbsp;— <em>не опция</em></h2>
        <p>Мы обрабатываем инструменты по тем же стандартам, что и медицинские кабинеты.</p>
      </div>

      <ol class="steps">
        {
          hygieneSteps.map((s, i) => (
            <li class="step" data-reveal style={`--d: ${i}`}>
              <span class="step__num" aria-hidden="true">
                0{i + 1}
              </span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <p class="brands" data-reveal>
        <span class="eyebrow">Работаем на материалах</span>
        <span class="brands__list">{brands.join(' · ')}</span>
      </p>
    </div>
  </div>
</section>

<style>
  .hygiene {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .hygiene__media {
    overflow: hidden;
    border-radius: var(--r-md);
  }

  .hygiene__media :global(picture) {
    display: block;
  }

  .hygiene__media :global(.hygiene__img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .steps {
    display: grid;
    gap: 1.75rem;
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--c-line);
  }

  .step p {
    margin-top: 0.375rem;
    color: var(--c-muted);
  }

  .step__num {
    font-family: var(--f-serif);
    font-size: 1.5rem;
    font-style: italic;
    line-height: 1.2;
    color: var(--c-accent);
  }

  .brands {
    display: grid;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .brands__list {
    font-family: var(--f-serif);
    font-size: 1.375rem;
    line-height: 1.4;
  }

  @media (min-width: 1024px) {
    .hygiene {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 5rem;
    }
  }
</style>
