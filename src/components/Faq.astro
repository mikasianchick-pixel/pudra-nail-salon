---
import { faq } from '../data/site';
---

<section class="section section--surface" aria-labelledby="faq-title">
  <div class="container faq">
    <div class="section-head" data-reveal>
      <p class="eyebrow">Вопросы</p>
      <h2 id="faq-title">Частые <em>вопросы</em></h2>
      <p>Не нашли ответ? Напишите нам&nbsp;— ответим в течение 15 минут.</p>
    </div>

    <div class="faq__list" data-reveal>
      {
        faq.map((item) => (
          <details class="qa" name="faq">
            <summary class="qa__q">
              <span>{item.q}</span>
              <span class="qa__icon" aria-hidden="true" />
            </summary>
            <p class="qa__a">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    gap: 1rem 4rem;
  }

  .faq__list {
    border-top: 1px solid var(--c-line);
  }

  .qa {
    border-bottom: 1px solid var(--c-line);
  }

  .qa__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 44px;
    padding: 1.25rem 0;
    font-family: var(--f-serif);
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
    font-weight: 600;
    line-height: 1.3;
    list-style: none;
    cursor: pointer;
  }

  .qa__q::-webkit-details-marker {
    display: none;
  }

  /* Плюс, превращающийся в минус */
  .qa__icon {
    position: relative;
    flex: none;
    width: 20px;
    height: 20px;
  }

  .qa__icon::before,
  .qa__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: var(--c-accent);
    transition: transform 0.3s var(--ease);
  }

  .qa__icon::after {
    transform: rotate(90deg);
  }

  .qa[open] .qa__icon::after {
    transform: rotate(0deg);
  }

  .qa__a {
    max-width: 40rem;
    padding-bottom: 1.5rem;
    color: var(--c-muted);
  }

  @media (min-width: 1024px) {
    .faq {
      grid-template-columns: 0.8fr 1.2fr;
    }
  }
</style>
